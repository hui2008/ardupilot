# hwdef for Duffy Linux board

env TOOLCHAIN native

define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_LINUX_DUFFY

# IMU: MPU6500 on Raspberry Pi SPI0 CE0 (/dev/spidev0.0)
IMU Invensense SPI:mpu6500 ROTATION_NONE
define INS_MAX_INSTANCES 3

define HAL_BARO_ALLOW_INIT_NO_BARO 1

#            NAME       BUS SUBDEV MODE       BPW CS_PIN         LOWSPD HIGHSPD
LINUX_SPIDEV "mpu6500"  0   0      SPI_MODE_0 8   SPI_CS_KERNEL  1*MHZ  11*MHZ
